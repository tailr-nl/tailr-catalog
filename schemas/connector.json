          "type": "string",
          "description": "Base URL of the API, e.g. https://api.mollie.com/v2. May contain {{VARS}}."
        },
        "auth": {
          "default": {
            "type": "none"
          },
          "description": "How Tailr Core signs in at the source: oauth2, bearer, basic, header, query or none.",
          "$ref": "#/$defs/__schema92"
        },
        "headers": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "tools": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema93"
          },
          "description": "The functions: each one is one call."
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "baseUrl",
        "tools"
      ],
      "additionalProperties": false
    },
    {
