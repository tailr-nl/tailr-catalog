  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "intro": {
          "description": "Short explanation shown on the user's overview. Plain text, no HTML.",
          "$ref": "#/$defs/__schema1"
        },
        "examples": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "whatsNew": {
          "description": "Short explanation shown with a newly available module. Plain text; not a separate event per function.",
          "$ref": "#/$defs/__schema1"
        },
        "adminOnly": {
          "description": "Only show this content to administrators. Useful for administration plugins.",
          "$ref": "#/$defs/__schema11"
        }
      },
      "additionalProperties": false
    },
    "__schema1": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema2"
        },
        {
          "$ref": "#/$defs/__schema3"
        }
      ]
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "en": {
          "$ref": "#/$defs/__schema4"
        },
        "nl": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "title": {
          "description": "Short, task-focused title for the question, e.g. Which orders need attention? The full prompt is copied unchanged.",
          "$ref": "#/$defs/__schema7"
        },
        "prompt": {
          "description": "A useful question the user can copy to their AI tool. Use plain language, not function names.",
          "$ref": "#/$defs/__schema1"
        },
        "requires": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          },
          "description": "Function names needed for this example. Connector: local function names; plugin: qualified function names. Only shown if the user may use all of them through AI."
        }
      },
      "required": [
        "prompt",
        "requires"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "object",
          "properties": {
            "en": {
              "$ref": "#/$defs/__schema8"
            },
            "nl": {
              "$ref": "#/$defs/__schema9"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "__schema8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "__schema9": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "__schema10": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "__schema11": {
      "type": "boolean"
    },
    "__schema12": {
      "description": "Unique id: lower-case letters, digits, - and _ (at most 48).",
      "$ref": "#/$defs/__schema13"
    },
    "__schema13": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
    },
    "__schema14": {
      "type": "string",
      "description": "Name of the system, e.g. Mollie."
    },
    "__schema15": {
      "default": "0.1.0",
      "description": "Version (MAJOR.MINOR.PATCH). Raise it on every change.",
      "$ref": "#/$defs/__schema16"
    },
    "__schema16": {
      "type": "string"
    },
    "__schema17": {
      "$ref": "#/$defs/__schema18"
    },
    "__schema18": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema19"
        },
        {
          "$ref": "#/$defs/__schema20"
        }
      ]
    },
    "__schema19": {
      "type": "string",
      "minLength": 1
    },
    "__schema20": {
      "type": "object",
      "properties": {
        "nl": {
          "$ref": "#/$defs/__schema21"
        },
        "en": {
          "$ref": "#/$defs/__schema22"
        }
      },
      "additionalProperties": false
    },
    "__schema21": {
      "type": "string",
      "minLength": 1
    },
    "__schema22": {
      "type": "string",
      "minLength": 1
    },
    "__schema23": {
      "description": "Release maturity, shown separately from the description.",
      "$ref": "#/$defs/__schema24"
    },
    "__schema24": {
      "type": "string",
      "enum": [
        "beta",
        "stable"
      ]
    },
    "__schema25": {
      "type": "string"
    },
    "__schema26": {
      "type": "string"
    },
    "__schema27": {
      "default": [],
      "description": "Settings the administrator fills in (keys, URLs). Use them as {{NAME}}.",
      "$ref": "#/$defs/__schema28"
    },
    "__schema28": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Name in UPPER_CASE, used as {{NAME}} in baseUrl, auth, headers and defaults."
          },
          "label": {
            "description": "Label on the setup page. English source, with optional translations.",
            "$ref": "#/$defs/__schema18"
          },
          "description": {
            "description": "Where the administrator finds this value at the source.",
            "$ref": "#/$defs/__schema18"
          },
          "secret": {
            "default": true,
            "description": "Secret values are encrypted and never shown again (default true). Use false for e.g. a shop URL.",
            "$ref": "#/$defs/__schema29"
          },
          "required": {
            "default": true,
            "type": "boolean"
          },
          "default": {
            "type": "string"
          },
          "pattern": {
            "type": "string",
            "maxLength": 200
          },
          "patternHint": {
            "type": "string",
            "maxLength": 300
          },
          "chooseWith": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]{1,64}$"
          }
        },
        "required": [
          "name",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "__schema29": {
      "type": "boolean"
    },
    "__schema30": {
      "type": "object",
      "properties": {
        "perSecond": {
          "$ref": "#/$defs/__schema31"
        },
        "perMinute": {
          "$ref": "#/$defs/__schema31"
        },
        "perHour": {
          "$ref": "#/$defs/__schema31"
        },
        "perDay": {
          "$ref": "#/$defs/__schema31"
        },
        "perUserPerDay": {
          "$ref": "#/$defs/__schema31"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "cacheTtlSeconds": {
          "maximum": 86400,
          "$ref": "#/$defs/__schema31"
        },
        "maxWaitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "remaining": {
                "type": "string"
              },
              "reset": {
                "type": "string"
              }
            },
            "required": [
              "remaining"
            ],
            "additionalProperties": false
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "__schema31": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema32": {
      "default": [],
      "description": "Extra hosts this connector may reach besides the host of baseUrl or url; the login only goes to these hosts.",
      "$ref": "#/$defs/__schema33"
    },
    "__schema33": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema34"
      }
    },
    "__schema34": {
      "type": "string",
      "minLength": 1
    },
    "__schema35": {
      "default": [],
      "description": "Code functions (tools/*.ts in the folder). They always run in the sandbox.",
      "$ref": "#/$defs/__schema36"
    },
    "__schema36": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema37"
      }
    },
    "__schema37": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/__schema38"
        },
        "title": {
          "$ref": "#/$defs/__schema39"
        },
        "summary": {
          "$ref": "#/$defs/__schema40"
        },
        "description": {
          "$ref": "#/$defs/__schema41"
        },
        "version": {
          "$ref": "#/$defs/__schema42"
        },
        "level": {
          "$ref": "#/$defs/__schema43"
        },
        "file": {
          "$ref": "#/$defs/__schema44"
        },
        "code": {
          "$ref": "#/$defs/__schema46"
        },
        "uses": {
          "$ref": "#/$defs/__schema47"
        },
        "requests": {
          "$ref": "#/$defs/__schema50"
        },
        "params": {
          "$ref": "#/$defs/__schema53"
        },
        "limits": {
          "$ref": "#/$defs/__schema62"
        },
        "audience": {
          "$ref": "#/$defs/__schema63"
        },
        "privacy": {
          "$ref": "#/$defs/__schema65"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "__schema38": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]{1,64}$"
    },
    "__schema39": {
      "$ref": "#/$defs/__schema18"
    },
    "__schema40": {
      "$ref": "#/$defs/__schema18"
    },
    "__schema41": {
      "type": "string"
    },
    "__schema42": {
      "default": "1.0.0",
      "type": "string",
      "maxLength": 32
    },
    "__schema43": {
      "default": "read",
      "type": "string",
      "enum": [
        "read",
        "write",
        "admin"
      ]
    },
    "__schema44": {
      "description": "File in the connector folder, e.g. tools/settlement_breakdown.ts. Give file or code.",
      "$ref": "#/$defs/__schema45"
    },
    "__schema45": {
      "type": "string",
      "maxLength": 200
    },
    "__schema46": {
      "type": "string",
      "maxLength": 200000
    },
    "__schema47": {
      "default": [],
      "description": "Functions the code may call with ctx.call: a function of this connector (\"list_items\") or alias.function for a connection from requires.",
      "$ref": "#/$defs/__schema48"
    },
    "__schema48": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema49"
      }
    },
    "__schema49": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_]{0,31}\\.)?[a-zA-Z0-9_]{1,64}$"
    },
    "__schema50": {
      "default": [],
      "description": "Requests the code may make with ctx.request: method plus path relative to baseUrl (* = one segment, ** = the rest).",
      "$ref": "#/$defs/__schema51"
    },
    "__schema51": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema52"
      }
    },
    "__schema52": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^\\/"
        }
      },
      "required": [
        "method",
        "path"
      ],
      "additionalProperties": false
    },
    "__schema53": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "in": {
            "default": "body",
            "type": "string",
            "enum": [
              "path",
              "query",
              "body",
              "header"
            ]
          },
          "type": {
            "$ref": "#/$defs/__schema54"
          },
          "required": {
            "$ref": "#/$defs/__schema55"
          },
          "description": {
            "$ref": "#/$defs/__schema56"
          },
          "enum": {
            "$ref": "#/$defs/__schema58"
          },
          "apiName": {
            "$ref": "#/$defs/__schema59"
          },
          "default": {
            "$ref": "#/$defs/__schema60"
          },
          "schema": {
            "$ref": "#/$defs/__schema61"
          }
        },
        "additionalProperties": false
      }
    },
    "__schema54": {
      "default": "string",
      "type": "string",
      "enum": [
        "string",
        "number",
        "integer",
        "boolean",
        "array",
        "object"
      ]
    },
    "__schema55": {
      "default": false,
      "type": "boolean"
    },
    "__schema56": {
      "description": "For the AI: what to fill in, with the format.",
      "$ref": "#/$defs/__schema57"
    },
    "__schema57": {
      "type": "string"
    },
