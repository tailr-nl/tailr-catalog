{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tailr Core plugin",
  "description": "plugin.json of a Tailr Core plugin. See docs/plugins-maken.md.",
  "x-tailr-version": "0.1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The JSON schema of this file, for completion in your editor."
    },
    "presentation": {
      "type": "object",
      "properties": {
        "intro": {
          "description": "Short explanation shown on the user's overview. Plain text, no HTML.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "nl": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "examples": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "description": "Short, task-focused title for the question, e.g. Which orders need attention? The full prompt is copied unchanged.",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "nl": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "prompt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1200
                  },
                  {
                    "type": "object",
                    "properties": {
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1200
                      },
                      "nl": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1200
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "A useful question the user can copy to their AI tool. Use plain language, not function names."
              },
              "requires": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "description": "Function names needed for this example. Connector: local function names; plugin: qualified function names. Only shown if the user may use all of them through AI."
              }
            },
            "required": [
              "prompt",
              "requires"
            ],
            "additionalProperties": false
          }
        },
        "whatsNew": {
          "description": "Short explanation shown with a newly available module. Plain text; not a separate event per function.",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "nl": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "adminOnly": {
          "description": "Only show this content to administrators. Useful for administration plugins.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$",
      "description": "Unique id; must equal the folder name. Lower-case letters, digits and hyphens."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Version of the plugin (semver, e.g. 1.2.0). Raise it on every change."
    },
    "api": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$",
      "description": "The plugin API this plugin needs, as \"major.minor\" (e.g. \"1.0\"). Use the lowest version that has everything you use; see \"Plugin API versions\" in docs/plugins.md."
    },
    "requires": {
      "description": "What must be present for this plugin to load.",
      "type": "object",
      "properties": {
        "core": {
          "description": "A version range for Tailr Core itself (rarely needed; prefer api).",
          "type": "string"
        },
        "plugins": {
          "description": "Plugins that must be installed, with a version range, e.g. { \"tools\": \">=1.0\" }. Use them with api.use.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "optional": {
      "description": "Plugins this plugin can do more with, but does not need.",
      "type": "object",
      "properties": {
        "plugins": {
          "description": "Plugins this plugin uses when they are installed, with a version range.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "nl": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Name on the Plugins page (Installed, Available) and the plugin page: a string (English), or per language { \"en\": \"…\", \"nl\": \"…\" }. English is the default."
    },
    "summary": {
      "description": "One sentence for the Plugins page (Available) and the plugin page: a string (English), or { \"en\": \"…\", \"nl\": \"…\" }.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "en": {
              "type": "string"
            },
            "nl": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "default": "index.ts",
      "description": "The file that exports register(api). Default index.ts.",
      "type": "string"
    },
    "hooks": {
      "description": "For the Plugins page (Available): where the plugin hooks in, e.g. \"guard tool.before\", \"screen\" or \"tool\".",
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "onFailure": {
      "default": "disable",
      "description": "After 5 failures in a row: \"disable\" turns the plugin off (default); \"block\" keeps it on so its guards keep refusing (for security plugins).",
      "type": "string",
      "enum": [
        "disable",
        "block"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "api",
    "title"
  ],
  "additionalProperties": false
}
