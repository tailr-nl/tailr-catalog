{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tailr Core translation",
  "description": "A translation file (Catalogue → Translations). The keys are the original Dutch texts; keep placeholders such as {name}.",
  "x-tailr-version": "0.1.0",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "The JSON schema of this file, for completion in your editor."
        },
        "name": {
          "description": "Name in the language menu, e.g. \"Deutsch\". Needed for a new language; not for en.",
          "type": "string",
          "maxLength": 40
        },
        "dateLocale": {
          "description": "Locale for dates and numbers, e.g. de-DE. Default: the language code.",
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "presentation": {
          "type": "object",
          "properties": {
            "intro": {
              "description": "Short explanation shown on the user's overview. Plain text, no HTML.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    },
                    "nl": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "examples": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "description": "Short, task-focused title for the question, e.g. Which orders need attention? The full prompt is copied unchanged.",
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      {
                        "type": "object",
                        "properties": {
                          "en": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          },
                          "nl": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 160
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  },
                  "prompt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1200
                      },
                      {
                        "type": "object",
                        "properties": {
                          "en": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1200
                          },
                          "nl": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1200
                          }
                        },
                        "additionalProperties": false
                      }
                    ],
                    "description": "A useful question the user can copy to their AI tool. Use plain language, not function names."
                  },
                  "requires": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "description": "Function names needed for this example. Connector: local function names; plugin: qualified function names. Only shown if the user may use all of them through AI."
                  }
                },
                "required": [
                  "prompt",
                  "requires"
                ],
                "additionalProperties": false
              }
            },
            "whatsNew": {
              "description": "Short explanation shown with a newly available module. Plain text; not a separate event per function.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    },
                    "nl": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1200
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "adminOnly": {
              "description": "Only show this content to administrators. Useful for administration plugins.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "messages": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 2000
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          },
          "description": "Texts of the web app and the gateway: original English text → translation."
        },
        "plugins": {
          "description": "Texts of installed plugins, per plugin id: original text → translation.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 2000
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 2000
            },
            "description": "Original English text → translation. Keep the keys exactly as they are, and keep placeholders such as {name} unchanged. Empty values are skipped."
          }
        }
      },
      "required": [
        "messages"
      ],
      "description": "A translation file for Tailr Core (Catalogue → Translations). Keys starting with _ are comments.",
      "additionalProperties": false,
      "patternProperties": {
        "^[_$]": {}
      }
    },
    {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 2000
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 2000
      },
      "description": "A flat file with only texts: original Dutch text → translation."
    }
  ]
}
